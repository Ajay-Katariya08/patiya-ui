{
  "name": "patiya",
  "version": "1.1.5",
  "type": "module",
  "main": "./dist/patiya.cjs",
  "module": "./dist/patiya.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/patiya.mjs",
      "require": "./dist/patiya.cjs"
    },
    "./styles": "./dist/styles/globals.css",
    "./themes/*": "./dist/styles/themes/*"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.0",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "cmdk": "^1.1.1",
    "cnfast": "^0.2.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.20.0",
    "eslint": "^9.20.1",
    "jest-axe": "^9.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwind",
    "accessible"
  ],
  "homepage": "https://patiya-ui.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ajay-Katariya08/patiya-ui"
  },
  "bugs": {
    "url": "https://github.com/Ajay-Katariya08/patiya-ui/issues"
  }
}
